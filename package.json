{
  "name": "git-undo-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Visual git undo button: reads `git reflog`, previews word-level diffs, and generates safe undo commands. Single-file, offline-first.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/admos98/git-undo-gui",
  "repository": {
    "type": "git",
    "url": "https://github.com/admos98/git-undo-gui.git"
  },
  "keywords": [
    "git",
    "reflog",
    "undo",
    "time-machine",
    "diff",
    "tui-alternative"
  ],
  "files": [
    "index.html",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "css:build": "node src/build-css.mjs",
    "dev": "npm run css:build && vite --port=3000 --host=0.0.0.0",
    "build": "npm run css:build && vite build && node scripts/sync-badge.mjs",
    "preview": "vite preview --port=4173 --host=0.0.0.0",
    "test": "node tests/run.mjs",
    "test:ci": "npm run css:build && node tests/run.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run build && npm run embed:web && tauri dev",
    "tauri:build": "npm run build && npm run embed:web && tauri build",
    "embed:web": "node scripts/embed-web.mjs",
    "badge": "node scripts/sync-badge.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.7",
    "@tauri-apps/cli": "^2.0.0"
  }
}
