# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Tauri
.tauri/
# Generated at build time by scripts/embed-web.mjs from dist/index.html. It is a
# copy of the UI, so committing it means every frontend edit touches two 200 KB
# files and contributors get to wonder which one is real. CI regenerates it
# before compiling, and tests/executor.test.mjs fails if a build ships a stale one.
src-tauri/assets/index.html

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env & secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Test / tooling caches
coverage/
.pytest_cache/
.ruff_cache/
.cache/
.turbo/
.playwright-cli/

# Screenshots / recordings used for the demo GIF
*.webm
*.mp4
tour-*.png

# Rust / Tauri build artifacts
src-tauri/target/
# The workspace has a second, nested crate. `src-tauri/target/` alone did not cover
# it, so `git add -A` staged ~250 build artifacts the first time this crate was built.
src-tauri/logic/target/
src-tauri/*/target/
src-tauri/logic/Cargo.lock
src-tauri/gen/
