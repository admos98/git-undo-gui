{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-undo-gui",
  "version": "0.1.0",
  "identifier": "dev.gitundo.gui",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "git-undo-gui",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "url": "http://app.localhost/"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Visual git undo from your reflog",
    "longDescription": "Reads your reflog, previews the undo, and generates the command. The optional desktop build can also run the reset itself, guarded and after taking a backup branch."
  }
}
